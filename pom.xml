<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.aiassist</groupId>
    <artifactId>ai-assist</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ai-assist</name>
    <description>Listen-and-draft assistant: captures spoken/typed notes and drafts detailed content</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          Offline speech-to-text (Apache-2.0). Used ONLY for the native
          libraries it bundles (libvosk for Linux/macOS/Windows on the
          classpath); its Java classes are bypassed because their eager JNA
          registration crashes on macOS where the bundled dylib lacks
          symbols they declare. See VoskNative for our own lazy binding.
        -->
        <dependency>
            <groupId>com.alphacephei</groupId>
            <artifactId>vosk</artifactId>
            <version>0.3.45</version>
        </dependency>
        <!--
          Whisper (OpenAI, MIT) via whisper.cpp — bundles native libs for
          macOS/Windows/Linux. Used for the accurate complete-conversation
          transcription of the recorded meeting on Stop; Vosk stays for the
          real-time live captions. Fully offline, CPU-only.
        -->
        <dependency>
            <groupId>io.github.givimad</groupId>
            <artifactId>whisper-jni</artifactId>
            <version>1.7.1</version>
        </dependency>
        <!--
          llama.cpp (MIT) via de.kherud:llama — an in-process, CPU-only LLM.
          Native libraries for macOS/Windows/Linux are bundled in the jar; the
          model is one GGUF instruct file the user drops in the app folder.
          Powers the summary, Editor and Compose when present; the app falls
          back to the offline rules when no model is installed. No server,
          no Ollama, nothing leaves the machine.
        -->
        <dependency>
            <groupId>de.kherud</groupId>
            <artifactId>llama</artifactId>
            <version>4.1.0</version>
        </dependency>
        <!-- Pinned to the version whose macOS resource lookup matches the vosk jar layout -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.7.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Boot 4 split TestRestTemplate/@AutoConfigureTestRestTemplate and
          RestTemplateCustomizer out of spring-boot-starter-test into their
          own modules (test-only; nothing here ships in the app itself).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                      These dependencies carry native libraries. Unpacking them
                      at runtime guarantees their loaders can extract the native
                      binary from a real jar file, even inside this fat jar.
                    -->
                    <requiresUnpack>
                        <dependency>
                            <groupId>de.kherud</groupId>
                            <artifactId>llama</artifactId>
                        </dependency>
                        <dependency>
                            <groupId>io.github.givimad</groupId>
                            <artifactId>whisper-jni</artifactId>
                        </dependency>
                    </requiresUnpack>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Release hardening: strip debug information (line numbers, local
          variable tables, source-file names) from the compiled classes so a
          decompiler produces far less readable output. Method parameter names
          are kept (parameters=true) because Spring's binding relies on them.
          This does not make bytecode un-decompilable — nothing can for the
          JVM — but it removes the metadata that makes decompiled code easy to
          read. Used by the packaging scripts:  mvn -Pharden package
        -->
        <profile>
            <id>harden</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <!-- Strip line numbers, local variables, and the
                                 source-file name so decompiled output is far
                                 less readable; keep parameter names for Spring. -->
                            <debug>false</debug>
                            <parameters>true</parameters>
                            <compilerArgs combine.children="append">
                                <arg>-g:none</arg>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          Optional convenience for developers: fetch the small English model
          into ./models next to the build so you can run the app immediately.
          The shipped app bundles NO model — users drop their own model .zip
          in the app folder and it is extracted on first start.
              mvn package -Pfetch-model
        -->
        <profile>
            <id>fetch-model</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <version>1.9.0</version>
                        <executions>
                            <execution>
                                <id>fetch-vosk-model</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>wget</goal>
                                </goals>
                                <configuration>
                                    <url>https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip</url>
                                    <unpack>true</unpack>
                                    <outputDirectory>${project.basedir}/models</outputDirectory>
                                    <skipCache>false</skipCache>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
